---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout
  current=""
  title="Got it — Easley Consulting"
  description="Your message landed. I'll write back personally within a week."
>
  <section class="section section--tight thanks">
    <div class="wrap wrap--narrow">
      <p class="eyebrow">Inquire</p>
      <h1>Got it.</h1>
      <p class="lede">
        Your message landed. I read these myself, and I'll write back personally within a week. If it's been longer than that, the form probably ate it — try <a href="mailto:thomas@eclecticschoolofherbalmedicine.com">thomas@eclecticschoolofherbalmedicine.com</a> directly.
      </p>
      <p style="margin-top: var(--space-4);"><a class="cta" href="/work">Back to the work</a></p>
    </div>
  </section>
</BaseLayout>

<style>
  .thanks h1 { margin-bottom: var(--space-3); }
</style>
