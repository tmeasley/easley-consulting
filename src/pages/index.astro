---
import BaseLayout from '../layouts/BaseLayout.astro';

const featured = [
  {
    title: 'Andalusia',
    blurb: 'Editorial city site for Andalusia, Alabama. Civic gazette aesthetic — population, geography, history, government, outdoors. Astro + content collections.',
    href: '/work#andalusia',
    domain: 'Business website',
    image: '/snapshots/andalusia.png',
  },
  {
    title: "Hunt & Fish Shelby",
    blurb: "Shelby County fishing and hunting almanac. Daily best-times calculated from moon, sun, and live conditions. Sponsored by Alabama Poured Walls.",
    href: 'https://huntandfishshelby.com',
    domain: 'Business website',
    image: '/snapshots/huntfish.png',
  },
  {
    title: 'Alabama Poured Walls',
    blurb: 'Central Alabama poured concrete foundation contractor. B2B-focused, builder-first contact funnel. Live since 2022.',
    href: 'https://alabamapouredwalls.com',
    domain: 'Business website',
    image: '/snapshots/apw.png',
  },
  {
    title: 'Encyclopaedia of Western Medicine',
    blurb: 'AI-powered reference on the history and philosophy of Western medicine. 700+ pages, 15,000+ verbatim evidence cards traced to primary sources, three-layer fidelity audit.',
    href: '/work#encyclopaedia',
    domain: 'AI system',
    image: '/snapshots/encyclopaedia.png',
  },
  {
    title: 'Mental Health Navigator',
    blurb: 'Searchable database of 100 mental health patterns drawn from 16 medical traditions across 5 millennia. Astro + Supabase.',
    href: '/work#mental-health-navigator',
    domain: 'Software',
    image: '/snapshots/mhn.png',
  },
  {
    title: 'HerbalMedicine.AI',
    blurb: "AI-navigated knowledge graph of Thomas's writings, curriculum, and clinical materia medica. Tier-gated chat product with WordPress membership integration.",
    href: '/work#hmai',
    domain: 'AI system',
    image: '/snapshots/hmai.png',
  },
];
---
<BaseLayout current="home">
  <section class="hero">
    <div class="wrap hero__inner">
      <div class="hero__text">
        <p class="eyebrow">Easley Consulting</p>
        <h1 class="hero__title">Thomas Easley.</h1>
        <p class="hero__sub">Herbalist, educator, builder of useful things.</p>
        <p class="hero__lede">
          I run a herbal medicine school, see clients in clinical practice, and write books. Alongside that I build software for researchers, historians, clinicians, and businesses — websites, AI systems, native apps, and the live-data pipelines that wire them together. When the problem is interesting and the people are good, I take on outside work.
        </p>
        <div class="cta-row">
          <a class="cta" href="/work">See the work</a>
          <a class="cta" href="/inquire">Start a conversation</a>
        </div>
      </div>
      <div class="hero__portrait">
        <img src="/portrait.jpg" alt="Thomas Easley" loading="eager" width="800" height="800" />
      </div>
    </div>
  </section>

  <section class="photo-band photo-band--narrow" aria-hidden="true">
    <img src="/photos/bookshelf.jpg" alt="" loading="lazy" />
  </section>

  <section class="section">
    <div class="wrap">
      <p class="eyebrow">What I do</p>
      <div class="grid grid--3 what">
        <div>
          <h3>Herbal medicine and clinical practice</h3>
          <p>Twenty-five years in clinical herbalism. Co-author of <em>The Modern Herbal Dispensatory</em>. I run the Eclectic School of Herbal Medicine and a community clinic in Andalusia, Alabama.</p>
        </div>
        <div>
          <h3>Education and curriculum design</h3>
          <p>Foundational and clinical curriculum used by hundreds of students across multiple programs. Practical pedagogy. Useful from week one.</p>
        </div>
        <div>
          <h3>Software, AI, and live data</h3>
          <p>Websites, AI systems, native apps, and live-data engines. The Encyclopaedia of Western Medicine (15,000+ evidence cards, 700+ pages), a hybrid reasoning-reranking search index over a 2,000-book reference library, and hyper-local content engines like Hunt & Fish Shelby with integrated solunar, USGS, and NWS data.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section who">
    <div class="wrap">
      <p class="eyebrow">Who I build for</p>
      <div class="who-grid">
        <div class="who-card">
          <h3>Researchers</h3>
          <p>Custom retrieval over your literature. Citation networks. Verbatim quote extraction. Knowledge graphs grounded in primary sources, not hallucinated summaries.</p>
        </div>
        <div class="who-card">
          <h3>Historians</h3>
          <p>Archive digitization with OCR and structured extraction. Evidence-grounded synthesis. Source-of-truth pipelines that quote verbatim, cite the page, and never paraphrase.</p>
        </div>
        <div class="who-card">
          <h3>Clinicians</h3>
          <p>Decision-support tools. Bloodwork analysis. SOAP note assistants. Clinical reasoning systems grounded in your own protocols and materia medica, not generic medical training data.</p>
        </div>
        <div class="who-card">
          <h3>Businesses</h3>
          <p>Knowledge graphs over internal documentation. Custom AI workflows for ops, training, and research. Practical, durable, built to last past the demo.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="photo-band" aria-hidden="true">
    <img src="/photos/apothecary.jpg" alt="" loading="lazy" />
  </section>

  <section class="section">
    <div class="wrap">
      <p class="eyebrow">Featured work</p>
      <div class="grid grid--3 cards">
        {featured.map((p) => (
          <a class="card" href={p.href}>
            <div class="card__image">
              <img src={p.image} alt={`${p.title} snapshot`} loading="lazy" />
            </div>
            <div class="card__body">
              <span class="card__tag">{p.domain}</span>
              <h3 class="card__title">{p.title}</h3>
              <p class="card__blurb">{p.blurb}</p>
              <span class="card__arrow" aria-hidden="true">→</span>
            </div>
          </a>
        ))}
      </div>
      <p style="margin-top: var(--space-4);"><a class="cta" href="/work">See the full portfolio</a></p>
    </div>
  </section>

  <section class="section inquire-cta">
    <div class="wrap wrap--narrow">
      <p class="eyebrow">Inquire</p>
      <h2>Selective by design.</h2>
      <p class="lede">
        I take a small number of outside projects each year, when the problem is interesting and the people are good. If that sounds like your situation, tell me about it.
      </p>
      <p style="margin-top: var(--space-3);"><a class="cta" href="/inquire">Start a conversation</a></p>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    padding: var(--space-7) 0 var(--space-6);
    border-bottom: 1px solid var(--rule-soft);
  }

  .hero__inner {
    display: grid;
    grid-template-columns: 1.5fr 1fr;
    gap: var(--space-6);
    align-items: center;
  }

  .hero__portrait {
    position: relative;
  }

  .hero__portrait img {
    display: block;
    width: 100%;
    max-width: 380px;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    object-position: center 20%;
    border-radius: 3px;
    filter: saturate(0.95) contrast(1.02);
    margin-left: auto;
    margin-right: 0;
  }

  @media (max-width: 820px) {
    .hero__inner {
      grid-template-columns: 1fr;
      gap: var(--space-4);
    }
    .hero__portrait { display: none; }
  }

  .hero__title {
    margin-bottom: var(--space-2);
  }

  .hero__sub {
    font-family: var(--serif);
    font-style: italic;
    font-size: clamp(1.15rem, 2.2vw, 1.6rem);
    color: var(--ink-soft);
    margin-bottom: var(--space-4);
    max-width: var(--measure);
  }

  .hero__lede {
    font-size: clamp(1.05rem, 1.6vw, 1.2rem);
    line-height: 1.55;
    color: var(--ink-soft);
    max-width: 38rem;
  }

  .what h3 {
    border-top: 1px solid var(--accent);
    padding-top: var(--space-2);
    margin-bottom: var(--space-2);
    font-size: 1.05rem;
    font-weight: 600;
    letter-spacing: -0.005em;
  }

  .what p {
    font-size: 0.98rem;
    line-height: 1.55;
    color: var(--ink-soft);
  }

  .cards .card {
    position: relative;
    display: block;
    background: var(--bg-elev);
    border: 1px solid var(--rule-soft);
    text-decoration: none;
    color: var(--ink);
    transition: border-color 120ms ease, transform 200ms ease, background 120ms ease;
    border-radius: 2px;
    overflow: hidden;
  }

  .cards .card:hover {
    border-color: var(--accent);
    transform: translateY(-2px);
  }

  .card__image {
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: var(--bg);
    border-bottom: 1px solid var(--rule-soft);
    position: relative;
  }

  .card__image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
    display: block;
    filter: saturate(0.9);
    transition: transform 400ms ease, filter 300ms ease;
  }

  .cards .card:hover .card__image img {
    transform: scale(1.02);
    filter: saturate(1.05);
  }

  .card__body {
    padding: var(--space-3);
  }

  .card__tag {
    font-family: var(--sans);
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--ink-faint);
    font-weight: 600;
    margin-bottom: 0.6rem;
    display: inline-block;
  }

  .card__title {
    font-size: 1.2rem;
    margin-bottom: 0.6rem;
    color: var(--ink);
  }

  .card__blurb {
    font-size: 0.95rem;
    line-height: 1.55;
    color: var(--ink-soft);
    margin-bottom: var(--space-2);
  }

  .card__arrow {
    color: var(--accent);
    font-family: var(--sans);
    transition: transform 200ms ease;
    display: inline-block;
  }

  .cards .card:hover .card__arrow { transform: translateX(4px); }

  .workflows-teaser, .inquire-cta {
    background: var(--bg-elev);
  }

  .photo-band {
    width: 100%;
    overflow: hidden;
    background: var(--bg-elev);
    border-top: 1px solid var(--rule-soft);
    border-bottom: 1px solid var(--rule-soft);
  }

  .photo-band img {
    display: block;
    width: 100%;
    height: clamp(220px, 38vw, 480px);
    object-fit: cover;
    object-position: center 55%;
    filter: saturate(0.95) contrast(1.02);
  }

  .photo-band--narrow img {
    height: clamp(180px, 28vw, 340px);
    object-position: center 50%;
  }

  @media (max-width: 720px) {
    .photo-band img {
      height: 200px;
    }
    .photo-band--narrow img {
      height: 160px;
    }
  }

  .who {
    background: var(--bg-elev);
  }

  .who-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-4);
    margin-top: var(--space-3);
  }

  .who-card {
    padding: var(--space-3) 0;
    border-top: 1px solid var(--accent);
  }

  .who-card h3 {
    font-size: 1.15rem;
    font-weight: 600;
    letter-spacing: -0.005em;
    margin-bottom: var(--space-2);
  }

  .who-card p {
    font-size: 0.98rem;
    line-height: 1.6;
    color: var(--ink-soft);
    max-width: 32rem;
  }

  @media (max-width: 720px) {
    .who-grid { grid-template-columns: 1fr; }
  }
</style>
