---
import BaseLayout from '../layouts/BaseLayout.astro';

const groups = [
  {
    title: 'Knowledge systems and software',
    items: [
      {
        title: 'NexSys',
        blurb: "Knowledge workspace product. Three surfaces: an expert knowledge graph (Nexus), the user's personal capture layer (Notes), and an AI thinking partner grounded in both (Thoughts). ThomasVault is the first deployment — 500+ herbal monographs, conditions, and clinical protocols, with tiered membership.",
        href: 'https://thomasvault.netlify.app',
      },
      {
        title: 'Encyclopaedia of Western Medicine',
        blurb: 'AI-powered reference covering the history and philosophy of Western medicine. 700+ pages, 15,000+ verbatim evidence cards traced to primary sources, three-layer fidelity audit, evidence-grade public wiki.',
        href: '/workflows#case-1',
      },
      {
        title: 'Mental Health Navigator',
        id: 'mental-health-navigator',
        blurb: 'Searchable database of 100 mental health patterns drawn from 16 medical traditions across 5 millennia. Astro + Supabase. Maps each pattern to modern diagnostic categories.',
      },
      {
        title: 'HerbalMedicine.AI',
        blurb: "AI-navigated knowledge graph database of Thomas's writings and curriculum. Tier-gated chat product with WordPress membership integration.",
        href: '/workflows#case-3',
      },
      {
        title: 'Western Materia Medica',
        blurb: 'Standalone app surfacing 200+ herb monographs with energetics, actions, and clinical use. Astro front end pulling from a private clinical-reference repo at build time.',
      },
      {
        title: 'ThomasBrain Search',
        blurb: 'Hybrid semantic and keyword MCP server over 200+ herbs, conditions, protocols, and curriculum. The retrieval layer behind every AI system above.',
      },
      {
        title: 'Prose',
        blurb: 'Mac and Windows markdown reader and editor. Clean typography, focused writing surface, designed for AI-assisted drafting workflows. First Electron app I shipped.',
        href: 'https://github.com/tmeasley/prose',
      },
    ],
  },
  {
    title: 'Education and clinic',
    items: [
      {
        title: 'Eclectic School of Herbal Medicine',
        blurb: 'Online and in-person herbal medicine education. Foundational, intermediate, and clinical programs. Hundreds of students enrolled across multiple cohorts.',
        href: 'https://eclecticschoolofherbalmedicine.com',
      },
      {
        title: 'Three Notch Community Health',
        blurb: 'Membership community health center in Andalusia, Alabama. Sliding-scale herbal consultations, community classes, and a 16-week Building Health curriculum. Alpha site for a Community Vitality Center model meant to be replicated.',
        href: 'https://threenotchcommunityhealth.com',
      },
      {
        title: 'Foundational Herbalism Textbook',
        blurb: 'Four-book structure, ~150,000 words. Foundations of the Body, Foundations of Medicine, Materia Medica, and Clinical Practice.',
      },
    ],
  },
  {
    title: 'Writing',
    items: [
      {
        title: 'Books',
        blurb: 'The Modern Herbal Dispensatory (with Steven Horne, North Atlantic Books). Three additional titles in print.',
      },
      {
        title: 'Substack',
        blurb: 'Long-form writing on herbal medicine, philosophy of medicine, and the practice of practice.',
      },
      {
        title: 'Materia Medica Weekly',
        blurb: 'Weekly herb magazine. Locked 10-page template; new herb every Monday.',
      },
    ],
  },
  {
    title: 'Practice',
    items: [
      {
        title: 'Clinical consultations',
        blurb: 'One-on-one herbal medicine consultations. Selective intake.',
      },
    ],
  },
];
---
<BaseLayout
  current="work"
  title="The work — Easley Consulting"
  description="Portfolio of Thomas Easley's work across knowledge systems, software, education, clinical practice, and writing."
>
  <section class="section section--tight intro">
    <div class="wrap wrap--narrow">
      <p class="eyebrow">Work</p>
      <h1>The work.</h1>
      <p class="lede">
        Most of what's listed below is live and in use. A few projects are still finding their shape. Everything ships, runs, or earns.
      </p>
      <p class="meta-note">
        This is the public-facing slice. Most of what I build is client work, internal tooling, or in-progress — happy to walk through any of it on request.
      </p>
    </div>
  </section>

  {groups.map((g) => (
    <section class="section group">
      <div class="wrap">
        <h2 class="group__title">{g.title}</h2>
        <div class="group__items">
          {g.items.map((item) => (
            <article class="item" id={item.id ?? undefined}>
              <h3 class="item__title">
                {item.href
                  ? <a href={item.href}>{item.title}</a>
                  : item.title
                }
              </h3>
              <p class="item__blurb">{item.blurb}</p>
              {item.href && item.href.startsWith('http') && (
                <p class="item__link">{item.href.replace('https://', '')}</p>
              )}
            </article>
          ))}
        </div>
      </div>
    </section>
  ))}

  <section class="section closer">
    <div class="wrap wrap--narrow">
      <h2>Something you'd want me to look at?</h2>
      <p class="lede">Tell me about it. I read every message and write back personally within a week.</p>
      <p style="margin-top: var(--space-3);"><a class="cta" href="/inquire">Start a conversation</a></p>
    </div>
  </section>
</BaseLayout>

<style>
  .intro h1 { margin-bottom: var(--space-3); }

  .meta-note {
    font-size: 0.92rem;
    color: var(--ink-faint);
    font-style: italic;
    margin-top: var(--space-3);
    padding-left: var(--space-2);
    border-left: 2px solid var(--rule);
  }

  .group__title {
    font-size: 0.82rem;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    color: var(--ink-faint);
    font-family: var(--sans);
    font-weight: 600;
    margin-bottom: var(--space-4);
    padding-bottom: var(--space-2);
    border-bottom: 1px solid var(--rule);
  }

  .group__items {
    display: grid;
    gap: var(--space-5);
  }

  .item {
    display: grid;
    grid-template-columns: 1fr 2fr;
    gap: var(--space-4);
    padding-bottom: var(--space-4);
    border-bottom: 1px solid var(--rule-soft);
  }

  .item:last-child { border-bottom: 0; }

  .item__title {
    font-size: 1.25rem;
    line-height: 1.2;
    margin: 0;
    font-weight: 500;
    letter-spacing: -0.005em;
  }

  .item__title a {
    text-decoration: none;
    color: var(--ink);
    border-bottom: 1px solid var(--accent);
    padding-bottom: 2px;
  }

  .item__title a:hover { color: var(--accent); }

  .item__blurb {
    font-size: 1rem;
    line-height: 1.6;
    color: var(--ink-soft);
    margin-bottom: 0.5rem;
  }

  .item__link {
    font-family: var(--mono);
    font-size: 0.82rem;
    color: var(--ink-faint);
    margin: 0;
  }

  .closer {
    background: var(--bg-elev);
    text-align: left;
  }

  @media (max-width: 720px) {
    .item { grid-template-columns: 1fr; gap: var(--space-2); }
  }
</style>
