---
import BaseLayout from '../layouts/BaseLayout.astro';

const groups = [
  {
    title: 'Business websites',
    items: [
      {
        title: 'Andalusia',
        id: 'andalusia',
        blurb: 'Editorial city site for Andalusia, Alabama. Civic gazette aesthetic with sections for history, government, community, economy, and outdoors. Astro + content collections, CMS-managed. In development.',
        image: '/snapshots/andalusia.png',
      },
      {
        title: "Hunt & Fish Shelby",
        blurb: "Shelby County, Alabama fishing and hunting almanac. Daily best-times computed from solunar tables, live USGS and NWS data. Editorial almanac aesthetic. Sponsored by Alabama Poured Walls.",
        href: 'https://huntandfishshelby.com',
        image: '/snapshots/huntfish.png',
      },
      {
        title: 'Alabama Poured Walls',
        blurb: 'Central Alabama poured concrete foundation contractor (Curtis Jackson, founded 2006). B2B-focused with a builder-direct phone line and a tire-kicker-filtering email form. Live since 2022.',
        href: 'https://alabamapouredwalls.com',
        image: '/snapshots/apw.png',
      },
      {
        title: 'South Alabama Spray Foam',
        blurb: 'Spray foam and insulation contractor serving Andalusia, Opp, Florala, and nearby communities. Same builder-funnel pattern as Alabama Poured Walls, retuned for residential insulation.',
        href: 'https://southalabamasprayfoam.com',
        image: '/snapshots/sasf.png',
      },
    ],
  },
  {
    title: 'Knowledge systems and software',
    items: [
      {
        title: 'Encyclopaedia of Western Medicine',
        id: 'encyclopaedia',
        blurb: 'AI-powered reference covering the history and philosophy of Western medicine. 700+ pages, 15,000+ verbatim evidence cards traced to primary sources, three-layer fidelity audit, evidence-grade wiki.',
        image: '/snapshots/encyclopaedia.png',
      },
      {
        title: 'Mental Health Navigator',
        id: 'mental-health-navigator',
        blurb: 'Searchable database of 100 mental health patterns drawn from 16 medical traditions across 5 millennia. Astro + Supabase. Maps each pattern to modern diagnostic categories.',
        image: '/snapshots/mhn.png',
      },
      {
        title: 'HerbalMedicine.AI',
        id: 'hmai',
        blurb: "AI-navigated knowledge graph database of Thomas's writings and curriculum. Tier-gated chat product with WordPress membership integration.",
        image: '/snapshots/hmai.png',
      },
      {
        title: 'Western Herbal Clinical Reference',
        id: 'whcr',
        blurb: '760-entry searchable reference grounded in Western herbal tradition. Conditions, interventions, and concepts in one cross-linked interface. Astro front end pulling from a private clinical-reference repo at build time.',
        image: '/snapshots/wmm.png',
      },
      {
        title: 'ThomasBrain Search',
        blurb: 'Hybrid reasoning-reranking search index over a 2,000-book reference library. MCP server that grounds every AI system above.',
      },
      {
        title: 'Prose',
        blurb: 'Mac and Windows markdown reader and editor. Clean typography, focused writing surface, designed for AI-assisted drafting workflows. First Electron app I shipped.',
        href: 'https://github.com/tmeasley/prose',
        image: '/snapshots/prose.png',
      },
    ],
  },
  {
    title: 'Education and clinic',
    items: [
      {
        title: 'Eclectic School of Herbal Medicine',
        blurb: 'Online and in-person herbal medicine education. Foundational, intermediate, and clinical programs. Hundreds of students enrolled across multiple cohorts.',
        href: 'https://eclecticschoolofherbalmedicine.com',
        image: '/snapshots/eshm.png',
      },
      {
        title: 'Three Notch Community Health',
        blurb: 'Membership community health center in Andalusia, Alabama. Sliding-scale herbal consultations, community classes, and a 16-week Building Health curriculum. Alpha site for a Community Vitality Center model meant to be replicated.',
        href: 'https://threenotchcommunityhealth.com',
        image: '/snapshots/tnch.png',
      },
      {
        title: 'Foundational Herbalism Textbook',
        blurb: 'Four-book structure, ~150,000 words. Foundations of the Body, Foundations of Medicine, Materia Medica, and Clinical Practice.',
      },
    ],
  },
  {
    title: 'Writing',
    items: [
      {
        title: 'The Modern Herbal Dispensatory',
        blurb: 'A medicine-making guide for the practicing herbalist. Co-authored with Steven Horne (North Atlantic Books, hardcover edition 2024).',
        href: 'https://www.northatlanticbooks.com/shop/the-modern-herbal-dispensatory-hardcover-edition/',
        image: '/snapshots/book.jpg',
        mediaKind: 'book',
      },
      {
        title: 'The Path Between',
        blurb: 'Substack. Long-form writing on herbal medicine, philosophy of science, and the history of healing. Recent: "Purity Doesn\'t Have Units," "Thinking Tools: Philosophy of Science for the Rest of Us," "Developing Clinical Thinking — The Theory of Dents."',
        href: 'https://thomaseasley.substack.com',
        image: '/snapshots/substack.png',
      },
    ],
  },
  {
    title: 'Practice',
    items: [
      {
        title: 'Clinical consultations',
        blurb: 'One-on-one herbal medicine consultations. Available through Three Notch Community Health (Andalusia, Alabama) and through my private practice at herbal.clinic. Selective intake.',
        href: 'https://herbal.clinic',
        image: '/snapshots/clinical.png',
      },
    ],
  },
];
---
<BaseLayout
  current="work"
  title="The work — Easley Consulting"
  description="Portfolio of Thomas Easley's work across knowledge systems, software, education, clinical practice, and writing."
>
  <section class="section section--tight intro">
    <div class="wrap wrap--narrow">
      <p class="eyebrow">Work</p>
      <h1>The work.</h1>
      <p class="lede">
        Most of what's listed below is live and in use. A few projects are still finding their shape. Everything ships, runs, or earns.
      </p>
      <p class="meta-note">
        This is the public-facing slice. Most of what I build is client work, internal tooling, or in-progress — happy to walk through any of it on request.
      </p>
    </div>
  </section>

  {groups.map((g) => (
    <section class="section group">
      <div class="wrap">
        <h2 class="group__title">{g.title}</h2>
        <div class="group__items">
          {g.items.map((item) => (
            <article class={`item${item.image ? ' item--has-image' : ''}${item.mediaKind ? ' item--' + item.mediaKind : ''}`} id={item.id ?? undefined}>
              <div class="item__media">
                {item.image ? (
                  item.href
                    ? <a href={item.href} class="item__image-link"><img src={item.image} alt={`${item.title} snapshot`} loading="lazy" /></a>
                    : <img src={item.image} alt={`${item.title} snapshot`} loading="lazy" />
                ) : (
                  <div class="item__placeholder" aria-hidden="true">
                    <span>{item.title.split(' ').map(w => w[0]).join('').slice(0,3).toUpperCase()}</span>
                  </div>
                )}
              </div>
              <div class="item__body">
                <h3 class="item__title">
                  {item.href
                    ? <a href={item.href}>{item.title}</a>
                    : item.title
                  }
                </h3>
                <p class="item__blurb">{item.blurb}</p>
                {item.href && item.href.startsWith('http') && (
                  <p class="item__link">{item.href.replace('https://', '')}</p>
                )}
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>
  ))}

  <section class="section closer">
    <div class="wrap wrap--narrow">
      <h2>Something you'd want me to look at?</h2>
      <p class="lede">Tell me about it. I read every message and write back personally within a week.</p>
      <p style="margin-top: var(--space-3);"><a class="cta" href="/inquire">Start a conversation</a></p>
    </div>
  </section>
</BaseLayout>

<style>
  .intro h1 { margin-bottom: var(--space-3); }

  .meta-note {
    font-size: 0.92rem;
    color: var(--ink-faint);
    font-style: italic;
    margin-top: var(--space-3);
    padding-left: var(--space-2);
    border-left: 2px solid var(--rule);
  }

  .group__title {
    font-size: 0.82rem;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    color: var(--ink-faint);
    font-family: var(--sans);
    font-weight: 600;
    margin-bottom: var(--space-4);
    padding-bottom: var(--space-2);
    border-bottom: 1px solid var(--rule);
  }

  .group__items {
    display: grid;
    gap: var(--space-5);
  }

  .item {
    display: grid;
    grid-template-columns: 320px 1fr;
    gap: var(--space-4);
    padding-bottom: var(--space-4);
    border-bottom: 1px solid var(--rule-soft);
    align-items: start;
  }

  .item:last-child { border-bottom: 0; }

  .item__media {
    width: 100%;
  }

  .item__media img {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    object-position: top center;
    background: var(--bg-elev);
    border: 1px solid var(--rule-soft);
    border-radius: 2px;
    filter: saturate(0.92);
    transition: filter 200ms ease, transform 200ms ease;
  }

  .item--book .item__media img {
    object-fit: contain;
    background: var(--bg-elev);
    padding: 0.5rem;
    aspect-ratio: 16 / 10;
  }

  .item__image-link { display: block; }
  .item__image-link:hover img {
    filter: saturate(1.05);
    transform: translateY(-2px);
  }

  .item__placeholder {
    width: 100%;
    aspect-ratio: 16 / 10;
    background: var(--bg-elev);
    border: 1px solid var(--rule-soft);
    border-radius: 2px;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  .item__placeholder::before {
    content: "";
    position: absolute;
    inset: 12px;
    border: 1px dashed var(--rule);
    border-radius: 1px;
  }

  .item__placeholder span {
    font-family: var(--serif);
    font-size: 1.8rem;
    font-weight: 500;
    color: var(--ink-faint);
    letter-spacing: 0.04em;
    position: relative;
  }

  .item__body {
    padding-top: 0.2rem;
  }

  .item__title {
    font-size: 1.25rem;
    line-height: 1.2;
    margin: 0 0 0.5rem;
    font-weight: 500;
    letter-spacing: -0.005em;
  }

  .item__title a {
    text-decoration: none;
    color: var(--ink);
    border-bottom: 1px solid var(--accent);
    padding-bottom: 2px;
  }

  .item__title a:hover { color: var(--accent); }

  .item__blurb {
    font-size: 1rem;
    line-height: 1.6;
    color: var(--ink-soft);
    margin-bottom: 0.5rem;
  }

  .item__link {
    font-family: var(--mono);
    font-size: 0.82rem;
    color: var(--ink-faint);
    margin: 0;
  }

  .closer {
    background: var(--bg-elev);
    text-align: left;
  }

  @media (max-width: 720px) {
    .item {
      grid-template-columns: 1fr;
      gap: var(--space-2);
    }
    .item__media { max-width: 100%; }
  }
</style>
